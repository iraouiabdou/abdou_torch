        "    truth = y_test[i:i+eval_batch_size]\n",
        "\n",
        "    correct += xp.sum(predictions == truth)\n",
        "    total += len(truth)\n",
        "\n",
        "acc = correct / total\n",
        "print(f\"Test Accuracy: {acc * 100:.2f}%\")"
